# =============================================================================
# Rewire 日次レポート Agent — 最小構成版（Option B: メーラー単体先行）
#
# 使い方:
#   1. このファイルを ~/.config/rewire/.env.analytics にコピー:
#        mkdir -p ~/.config/rewire
#        cp scripts/analytics/.env.analytics.example ~/.config/rewire/.env.analytics
#        chmod 600 ~/.config/rewire/.env.analytics
#   2. 下の RESEND_API_KEY だけ取得してペースト（他はデフォルトのままでOK）
#   3. python3 -m scripts.analytics.send_daily --dry-run で出力確認
#   4. python3 -m scripts.analytics.send_daily で実送信
# =============================================================================


# --- 1. Resend (メール送信) [必須] ----------------------------------------
# 取得手順:
#   1) https://resend.com/ で Sign in with Google（30秒）
#   2) API Keys → Create API Key → Full access
#   3) "re_" で始まるキーをここにペースト
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ドメイン認証前はこのまま。Gmail 迷惑判定された場合は独自ドメイン認証 (Phase 5)
RESEND_FROM=Rewire Analytics <onboarding@resend.dev>


# --- 2. 配信先 [変更不要] --------------------------------------------------
# Resend 無料枠は Resend アカウント所有者本人のメールアドレスにしか送信できない。
# ドット有/無で Gmail は同一だが Resend は文字列マッチで検証するため、アカウント
# 登録時のアドレスとビット単位で一致させること（Sign in with Google なら通常ドット無）。
REPORT_TO_EMAIL=arimurahiroaki40@gmail.com


# --- 3. Claude CLI (Max プラン活用、API Key 不要) [変更不要] ----------------
# subprocess で `claude -p` ヘッドレス実行。インストール済の Max プランで $0
CLAUDE_CMD=claude


# --- 4. その他 [変更不要] --------------------------------------------------
REPORT_TIMEZONE=Asia/Tokyo


# --- 5. RevenueCat [任意 / Phase B 拡張] -----------------------------------
# 取得手順:
#   1) https://app.revenuecat.com/ → Project settings → API keys
#   2) "+ New" → V2 Secret API Key 発行。Charts metrics / Customer information /
#      Project configuration の各カテゴリで "Read" を選択（Write は不要）
#   3) URL の /projects/<ここ> 部分の手前に "proj" を付けたものが Project ID
#      （例: URL が cb6956cd なら REVENUECAT_PROJECT_ID=projcb6956cd）
REVENUECAT_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
REVENUECAT_PROJECT_ID=projxxxxxxxx


# --- 6. Firebase / GA4 [任意 / Phase C 拡張] -------------------------------
# 取得手順:
#   1) https://console.firebase.google.com/ → Rewire → ⚙️ Project settings
#      → Integrations → Google Analytics を確認、GA4 Property ID (10桁) を控える
#   2) https://console.cloud.google.com/ で同じ GCP プロジェクトを選択
#   3) APIs & Services → Library → "Google Analytics Data API" を Enable
#   4) IAM & Admin → Service Accounts → Create:
#        Name: rewire-analytics-reader
#        Role: なし（GA4 Property レベルでのみ Viewer 付与する最小権限方針）
#   5) Keys → Add Key → JSON ダウンロード → 以下に配置:
#        mkdir -p ~/.config/firebase
#        mv ~/Downloads/<sa>.json ~/.config/firebase/ga4-sa.json
#        chmod 600 ~/.config/firebase/ga4-sa.json
#   6) JSON 内の "client_email" をコピー
#   7) https://analytics.google.com/ → Admin → Property access management
#      → その client_email を Viewer で追加
GA4_PROPERTY_ID=123456789
GOOGLE_APPLICATION_CREDENTIALS=~/.config/firebase/ga4-sa.json
